{
  "name": "axon-erp-api",
  "version": "1.0.0",
  "description": "CAP warehouse OData mock for Axon SAP connector",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy": "cds deploy --to sqlite",
    "verify:seed": "powershell -File scripts/verify-seed.ps1",
    "verify:cf": "powershell -File scripts/verify-seed.ps1 -UseCf",
    "build:mtar": "npm run build && mbt build -p=cf",
    "deploy:cf": "npm run build:mtar && cf deploy mta_archives/axon-odata-api_1.0.0.mtar -f"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2.4",
    "@cap-js/postgres": "^2",
    "@sap/cds": "9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "overrides": {
    "qs": ">=6.15.2",
    "ws": ">=8.20.1",
    "@sap/cds-dk": {
      "qs": ">=6.15.2",
      "ws": ">=8.20.1"
    }
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "sqlite",
          "credentials": {
            "url": "axon-odata-api.db"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin",
                "authenticated-user"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true,
      "portal": true
    },
    "odata": {
      "version": "v4"
    },
    "build": {
      "target": "gen",
      "tasks": [
        {
          "for": "postgres",
          "src": "db"
        },
        {
          "for": "nodejs",
          "src": "srv"
        }
      ]
    }
  }
}
