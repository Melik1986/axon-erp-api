{
  "name": "axon-erp-api",
  "version": "1.0.0",
  "description": "CAP warehouse OData mock for Axon SAP connector",
  "scripts": {
    "start": "scripts/with-node24.sh cds-serve",
    "watch": "scripts/with-node24.sh cds watch",
    "build": "scripts/with-node24.sh sh -c 'npx cds build --production && node scripts/patch-gen-srv.js'",
    "deploy": "scripts/with-node24.sh cds deploy --to sqlite",
    "build:mtar": "scripts/with-node24.sh sh -c 'npm run build && npx mbt build -p=cf'",
    "deploy:cf": "npm run build:mtar && cf deploy mta_archives/axon-odata-api_1.0.0.mtar -f",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "deploy:content:cf": "node scripts/validate-manifest.mjs && npm run build:mtar && cf deploy mta_archives/axon-odata-api_1.0.0.mtar -f -m axon-warehouse-ops-content,axon-destinations",
    "fix:workzone-destinations": "node scripts/fix-workzone-destinations.mjs",
    "clean:html5:cf": "node scripts/clean-html5-repo.mjs",
    "reset:content:cf": "node scripts/clean-html5-repo.mjs && npm run deploy:content:cf",
    "workzone:verify": "node scripts/verify-workzone-site.mjs",
    "workzone:verify-cloud": "node scripts/verify-workzone-cloud.mjs",
    "workzone:trace": "node scripts/trace-workzone-path.mjs",
    "format": "prettier --write \"**/*.{js,mjs,json,yaml,yml,html,css,md}\"",
    "check:format": "prettier --check \"**/*.{js,mjs,json,yaml,yml,html,css,md}\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds": "9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "prettier": "3.8.1"
  },
  "overrides": {
    "qs": "6.15.2",
    "ws": "8.20.1",
    "@sap/cds-dk": {
      "qs": "6.15.2",
      "ws": "8.20.1"
    }
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin",
                "authenticated-user"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true
    },
    "odata": {
      "version": "v4"
    },
    "build": {
      "target": "gen",
      "tasks": [
        {
          "for": "hana",
          "src": "db"
        },
        {
          "for": "nodejs",
          "src": "srv"
        }
      ]
    }
  }
}
