{
  "name": "axon-erp-api",
  "version": "1.0.0",
  "description": "CAP warehouse OData mock for Axon SAP connector",
  "scripts": {
    "start": "scripts/with-node24.sh cds-serve",
    "watch": "scripts/with-node24.sh cds watch",
    "build": "scripts/with-node24.sh sh -c 'npx cds build --production && node scripts/patch-gen-srv.js'",
    "deploy": "scripts/with-node24.sh cds deploy --to sqlite",
    "verify:seed": "scripts/with-node24.sh node scripts/verify-seed.mjs",
    "verify:cf": "scripts/with-node24.sh node scripts/verify-seed.mjs --base-url https://590c8b3dtrial-590c8b3dtrial-dev-axon-odata-api.cfapps.us10-001.hana.ondemand.com/odata/v4/warehouse",
    "verify:seed:ps": "powershell -File scripts/verify-seed.ps1",
    "build:mtar": "scripts/with-node24.sh sh -c 'npm run build && mbt build -p=cf'",
    "deploy:cf": "npm run build:mtar && cf deploy mta_archives/axon-odata-api_1.0.0.mtar -f",
    "format": "prettier --write \"**/*.{js,mjs,json,yaml,yml,html,css,md}\"",
    "check:format": "prettier --check \"**/*.{js,mjs,json,yaml,yml,html,css,md}\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds": "9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "prettier": "3.8.1"
  },
  "overrides": {
    "qs": ">=6.15.2",
    "ws": ">=8.20.1",
    "@sap/cds-dk": {
      "qs": ">=6.15.2",
      "ws": ">=8.20.1"
    }
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin",
                "authenticated-user"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true,
      "workzone": true,
      "portal": true
    },
    "odata": {
      "version": "v4"
    },
    "build": {
      "target": "gen",
      "tasks": [
        {
          "for": "hana",
          "src": "db"
        },
        {
          "for": "nodejs",
          "src": "srv"
        }
      ]
    }
  }
}
