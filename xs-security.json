{
  "$schema": "https://raw.githubusercontent.com/SAP/cloud-security-xsuaa-integration/master/xs-security-schema.json",
  "xsappname": "axon-integration",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "uaa.user",
      "description": "Default user scope (CAP authenticated-user)"
    },
    {
      "name": "$XSAPPNAME.admin",
      "description": "Admin"
    },
    {
      "name": "$XSAPPNAME.user",
      "description": "Authenticated OData user"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "scope-references": ["$XSAPPNAME.admin", "$XSAPPNAME.user"]
    },
    {
      "name": "User",
      "scope-references": ["uaa.user", "$XSAPPNAME.user"]
    }
  ],
  "role-collections": [
    {
      "name": "Warehouse_Ops_CAP_User",
      "description": "CAP OData for axon.warehouse.ops (OAuth2UserTokenExchange to axon-odata-api)",
      "role-template-references": ["$XSAPPNAME.User"]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://axon-app-staging.up.railway.app/api/erp/connect/callback",
      "https://*.cfapps.*.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**",
      "http://localhost:*/**"
    ]
  },
  "attributes": []
}
