{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/index.html$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/fiori.html$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/odata/v4/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/resources/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    }
  ]
}
