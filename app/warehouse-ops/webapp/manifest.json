{
  "_version": "1.60.0",
  "sap.app": {
    "id": "axon.warehouse.ops",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.20"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/warehouse/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "WarehouseOps-display": {
          "semanticObject": "WarehouseOps",
          "action": "display",
          "title": "{{warehouseOpsTileTitle}}",
          "subTitle": "{{warehouseOpsTileSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "WarehouseCatalog-display": {
          "semanticObject": "WarehouseCatalog",
          "action": "display",
          "title": "{{warehouseCatalogTileTitle}}",
          "subTitle": "{{warehouseCatalogTileSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "axon.warehouse.ops"
  },
  "sap.platform.cf": {
    "oAuthRegistrationId": "axon-warehouse-ops-auth"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "componentPreload": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.fe.core": {},
        "sap.ui.core": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "axon.warehouse.ops.ext.controller.WarehouseOpsListExt"
          }
        }
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "axon.warehouse.ops.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "WarehouseOpsList",
          "target": "WarehouseOpsList"
        },
        {
          "pattern": "Products({key}):?query:",
          "name": "WarehouseProductDetail",
          "target": "WarehouseProductDetail"
        },
        {
          "pattern": "BusinessPartners",
          "name": "WarehouseCatalogList",
          "target": "WarehouseCatalogList"
        }
      ],
      "targets": {
        "WarehouseOpsList": {
          "type": "Component",
          "id": "WarehouseOpsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Products",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "liveMode": true,
              "hideFilterBar": true,
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Default",
              "navigation": {
                "Products": {
                  "detail": {
                    "route": "WarehouseProductDetail"
                  }
                }
              },
              "tableSettings": {
                "type": "ResponsiveTable",
                "selectAll": true,
                "selectionMode": "Multi"
              }
            }
          }
        },
        "WarehouseProductDetail": {
          "type": "Component",
          "id": "WarehouseProductDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Products",
              "editableHeaderContent": true
            }
          }
        },
        "WarehouseCatalogList": {
          "type": "Component",
          "id": "WarehouseCatalogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/A_BusinessPartner",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "tableSettings": {
                "type": "ResponsiveTable",
                "selectAll": true,
                "selectionMode": "Multi"
              }
            }
          }
        }
      },
      "config": {}
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
