{
  "_version": "3.0.0",
  "identification": {
    "title": "axon-erp-api",
    "id": "axon-erp-api-flp",
    "entityType": "bundle"
  },
  "payload": {
    "catalogs": [
      {
        "_version": "3.0.0",
        "identification": {
          "id": "axon-erp-api-catalog",
          "title": "{{title}}",
          "entityType": "catalog",
          "i18n": "i18n/catalog.properties"
        },
        "viz": [
          {
            "appId": "axon.warehouse.products",
            "vizId": "axon.warehouse.products-tile",
            "vizConfig": {
              "sap.flp": {
                "target": {
                  "appId": "axon.warehouse.products",
                  "inboundId": "Products-display"
                }
              },
              "sap.ui": {
                "icons": {
                  "icon": "sap-icon://product"
                }
              },
              "sap.app": {
                "title": "Products",
                "subTitle": "Coffee catalogue"
              }
            }
          },
          {
            "appId": "axon.warehouse.stocklevels",
            "vizId": "axon.warehouse.stocklevels-tile",
            "vizConfig": {
              "sap.flp": {
                "target": {
                  "appId": "axon.warehouse.stocklevels",
                  "inboundId": "StockLevels-display"
                }
              },
              "sap.ui": {
                "icons": {
                  "icon": "sap-icon://inventory"
                }
              },
              "sap.app": {
                "title": "Stock Levels",
                "subTitle": "Warehouse overview"
              }
            }
          },
          {
            "appId": "axon.warehouse.invoices",
            "vizId": "axon.warehouse.invoices-tile",
            "vizConfig": {
              "sap.flp": {
                "target": {
                  "appId": "axon.warehouse.invoices",
                  "inboundId": "Invoices-display"
                }
              },
              "sap.ui": {
                "icons": {
                  "icon": "sap-icon://document"
                }
              },
              "sap.app": {
                "title": "Invoices",
                "subTitle": "Open & posted invoices"
              }
            }
          },
          {
            "appId": "axon.warehouse.businesspartners",
            "vizId": "axon.warehouse.businesspartners-tile",
            "vizConfig": {
              "sap.flp": {
                "target": {
                  "appId": "axon.warehouse.businesspartners",
                  "inboundId": "BusinessPartner-display"
                }
              },
              "sap.ui": {
                "icons": {
                  "icon": "sap-icon://business-partner"
                }
              },
              "sap.app": {
                "title": "Business Partners",
                "subTitle": "Suppliers & customers"
              }
            }
          }
        ]
      },
      {
        "_version": "3.0.0",
        "identification": {
          "id": "axon-erp-api-group",
          "title": "{{title}}",
          "entityType": "group",
          "i18n": "i18n/group.properties"
        },
        "payload": {
          "viz": [
            {
              "appId": "axon.warehouse.products",
              "vizId": "axon.warehouse.products-tile"
            },
            {
              "appId": "axon.warehouse.stocklevels",
              "vizId": "axon.warehouse.stocklevels-tile"
            },
            {
              "appId": "axon.warehouse.invoices",
              "vizId": "axon.warehouse.invoices-tile"
            },
            {
              "appId": "axon.warehouse.businesspartners",
              "vizId": "axon.warehouse.businesspartners-tile"
            }
          ]
        }
      }
    ],
    "sites": [
      {
        "_version": "3.0.0",
        "identification": {
          "id": "axon-erp-api-site",
          "entityType": "site",
          "title": "axon-erp-api",
          "description": "A simple CAP project."
        },
        "payload": {
          "config": {
            "ushellConfig": {
              "renderers": {
                "fiori2": {
                  "componentData": {
                    "config": {
                      "applications": {
                        "Shell-home": {}
                      },
                      "enableSearch": true,
                      "enablePersonalization": true,
                      "enableSetTheme": true,
                      "enableSetLanguage": true
                    }
                  }
                }
              }
            }
          },
          "groupsOrder": [
            "axon-erp-api-group"
          ],
          "sap.cloud.portal": {
            "config": {
              "theme.id": "sap_horizon",
              "theme.active": [
                "sap_horizon",
                "sap_horizon_dark",
                "sap_horizon_hcw",
                "sap_horizon_hcb"
              ]
            }
          }
        }
      }
    ]
  }
}